+          "building": "town-hall",
+          "say": "Start an engagement of kind 'meeting' with the transcript and your notes."
+        },
+        {
+          "building": "notary",
+          "say": "One page of notes cited to the transcript plus your actions as tasks. Review them, then they go to the tracker (G5)."
+        }
