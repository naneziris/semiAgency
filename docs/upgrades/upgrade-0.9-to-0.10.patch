+          "building": "town-hall",
+          "say": "Start an engagement of kind 'deck'. Put your notes, documents or a draft deck in the folder."
+        },
+        {
+          "building": "archive",
+          "say": "Copilot extracts the key messages and facts (/content), cited. You check them — gate G1."
+        },
+        {
+          "building": "design-studio",
+          "say": "Two storylines from the content (/storylines); you pick one (G3)."
+        },
+        {
+          "building": "print-house",
+          "say": "Outline, then the .pptx. Open it (G4). Speaker notes live next door at the Theatre."
+        }
+      ]
+    },
+    {
+      "id": "meeting",
+      "q": "I just want a record of a meeting and my actions",
+      "when": "A meeting happened, you owe nobody a deck, but you want a clean one-page write-up and your actions captured before you forget. Two stops, ten minutes.",
