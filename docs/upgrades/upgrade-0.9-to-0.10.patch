+    },
+    {
+      "id": "m365",
+      "q": "I live in Outlook and Teams — no VS Code",
+      "when": "You want your mornings, meeting filing and email drafting handled inside Microsoft 365 with no local setup. Build the stops in this order; each one takes 10–45 minutes once, then runs by itself or on one click.",
+      "stops": [
+        {
+          "building": "radio-tower",
+          "say": "A scheduled prompt that writes your morning brief every weekday. Proves scheduled prompts work in your tenant."
+        },
+        {
+          "building": "harbour-office",
+          "say": "A flow that files every meeting transcript into a SharePoint folder and a OneNote page, automatically."
+        },
+        {
+          "building": "lighthouse",
+          "say": "An evening prompt that prepares tomorrow's meetings from what was filed."
